**/.vite/
**/.cache/
**/.npm/
**/.pnpm-store/
**/.yarn/cache/
**/coverage/
**/qa.html
*.tsbuildinfo
*.log

# Local credentials and machine files
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
Desktop.ini
